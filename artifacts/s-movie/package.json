{
  "name": "@workspace/s-movie",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "sh -c 'if [ -n \"$REPLIT_EXPO_SESSION_SECRET\" ]; then pnpm exec create-launch login --session \"$REPLIT_EXPO_SESSION_SECRET\" || true; fi' && env -u EXPO_TOKEN EXPO_PACKAGER_PROXY_URL=https://$REPLIT_EXPO_DEV_DOMAIN EXPO_PUBLIC_DOMAIN=$REPLIT_DEV_DOMAIN EXPO_PUBLIC_REPL_ID=$REPL_ID EXPO_PUBLIC_GEMINI_API_KEY=\"${GEMINI_API_KEY:-}\" REACT_NATIVE_PACKAGER_HOSTNAME=$REPLIT_DEV_DOMAIN pnpm exec expo start --localhost --port $PORT",
    "build": "node scripts/build.js",
    "prebuild": "pnpm run verify-hero-lock",
    "serve": "node server/serve.js",
    "verify-hero-lock": "node scripts/verifyHeroLock.mjs",
    "typecheck": "pnpm run verify-hero-lock && tsc -p tsconfig.json --noEmit",
    "lint": "pnpm run verify-hero-lock && tsc -p tsconfig.json --noEmit",
    "publish-update": "EAS_NO_VCS=1 pnpm exec eas update --branch preview --message \"S Movie Original OTA update\" --non-interactive",
    "build-apk": "EAS_NO_VCS=1 pnpm exec eas build --platform android --profile preview --non-interactive --no-wait",
    "ota-update": "EAS_NO_VCS=1 pnpm exec eas update --branch preview --message \"S Movie Original OTA update\" --non-interactive",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@expo-google-fonts/inter": "^0.4.0",
    "@expo/cli": "57.0.27",
    "@expo/metro-runtime": "~57.0.16",
